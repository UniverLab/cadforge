width = 0.6
height = 0.5
color = "#66AAFF"

# ── Dormitorio 2 ────────────────────────────────────────────

# Cama individual
[[rect]]
id = "rc-cama-d2"
origin = [7.5, 0.5]
width = 1.5
height = 2.0
color = "#4488FF"

# Escritorio
[[rect]]
id = "rc-escritorio"
