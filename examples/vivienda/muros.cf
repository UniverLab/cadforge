[layer]
name = "muros"
color = "#FFFFFF"
line_weight = 0.50

# Perímetro exterior
[[polyline]]
id = "pl-perimetro"
points = [[0.0, 0.0], [8.5, 0.0], [8.5, 6.0], [0.0, 6.0]]
closed = true
weight = 0.50

# Muro divisorio vertical (sala | habitación)
[[line]]
id = "ln-div-v"
from = [4.0, 0.0]
to = [4.0, 6.0]
weight = 0.35

# Muro divisorio horizontal (habitación | baño)
[[line]]
id = "ln-div-h"
from = [4.0, 3.5]
to = [8.5, 3.5]
weight = 0.35
