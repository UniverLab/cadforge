[layer]
name = "planta"
color = "#50FF50"
line_weight = 0.35

# Media nave del taller: el espejo completa la planta simétrica respecto a x = 2.5
[[polyline]]
id = "pl-nave"
points = [
    [0.0, -4.6],
    [2.5, -4.6],
    [2.5, -2.4],
    [0.6, -2.4],
    [0.6, -3.0],
    [0.0, -3.0],
]
closed = false
weight = 0.50

# Puerta con su abatimiento
[[line]]
id = "ln-puerta"
from = [0.9, -2.4]
to = [1.7, -2.4]
color = "#FFC850"

[[arc]]
id = "ar-puerta"
center = [0.9, -2.4]
radius = 0.8
from_angle = 0.0
to_angle = 90.0
color = "#FFC850"

# Bancos de trabajo en serie (array lineal)
[[rect]]
id = "rc-banco"
origin = [0.3, -4.4]
width = 0.8
height = 0.5
color = "#C878FF"

[[array]]
id = "ar-bancos"
target = "rc-banco"
mode = "linear"
count = 3
offset = [1.3, 0.0]

[[mirror]]
id = "mr-nave"
targets = ["pl-nave", "ln-puerta", "ar-puerta"]
axis = [[2.5, 0.0], [2.5, 1.0]]
