[layer]
name = "mobiliario"
color = "#4488FF"

# ── Sala ─────────────────────────────────────────────────────

# Sofa
[[rect]]
id = "rc-sofa"
origin = [6.0, 7.5]
width = 3.0
height = 1.0
color = "#4488FF"

# Mesa de centro
[[rect]]
id = "rc-mesa-centro"
origin = [7.0, 6.5]
width = 1.5
height = 0.8
color = "#66AAFF"

# TV
[[rect]]
id = "rc-tv"
origin = [5.5, 5.5]
width = 0.2
height = 2.5
color = "#333333"

# Silla
[[circle]]
id = "ci-silla"
center = [10.0, 7.0]
radius = 0.3
color = "#66AAFF"

# ── Dormitorio 1 ────────────────────────────────────────────

# Cama doble
[[rect]]
id = "rc-cama-d1"
origin = [1.0, 6.2]
width = 2.0
height = 2.5
color = "#4488FF"

# Mesita de noche 1
[[rect]]
id = "rc-mesita1"
